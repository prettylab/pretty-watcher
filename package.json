{
  "name": "@prettylab/pretty-watcher",
  "version": "0.2.0",
  "description": "Logs, HTTP traffic and user actions from a Node app, pushed to Pretty Server Manager - plus the manager's watchdog agent",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pretty": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent/agent.mjs": "./agent/agent.mjs",
    "./agent/update.sh": "./agent/update.sh",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "agent",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "logging",
    "monitoring",
    "audit",
    "nextjs",
    "pretty-server-manager"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run check:agent && npm test",
    "check:agent": "node --check agent/agent.mjs && bash -n agent/update.sh",
    "release": "bash scripts/publish.sh"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
